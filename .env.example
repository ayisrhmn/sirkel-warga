# Postgres.
# Local:      postgresql://postgres:postgres@localhost:5432/sirkel
# Production: Neon pooled URL (region Singapore)
DATABASE_URL=
# Optional: direct (non-pooled) URL for migrations, when DATABASE_URL is the pooled one.
DIRECT_URL=

# Better Auth. Secret: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Signs the access cookie for `protected` datasets. Required, min 16 characters:
# openssl rand -base64 32
COOKIE_SECRET=

# Optional. When set, /register asks for this code, so only people you gave it
# to can sign up (accounts still need your approval).
REGISTRATION_CODE=
