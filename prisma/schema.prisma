generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnnouncementStatus {
  draft
  public

  @@map("announcement_status")
}

enum DatasetVisibility {
  draft
  public
  protected

  @@map("dataset_visibility")
}

model Community {
  id                    String         @id @default(uuid()) @db.Uuid
  // Immutable after creation (changing it requires a redirect).
  slug                  String         @unique
  name                  String
  // scrypt hash for the `protected` datasets of this community (Phase 3).
  protectedPasswordHash String?        @map("protected_password_hash")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  announcements         Announcement[]
  events                Event[]
  contacts              Contact[]
  datasets              Dataset[]
  memberships           Membership[]

  @@map("communities")
}

enum MembershipRole {
  owner
  admin

  @@map("membership_role")
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String         @map("community_id") @db.Uuid
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  role        MembershipRole
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Also in the migration SQL as partial unique indexes (Prisma cannot express
  // them): one owner per community, and one owned community per user.
  @@unique([userId, communityId])
  @@index([communityId])
  @@map("memberships")
}

model Announcement {
  id          String             @id @default(uuid()) @db.Uuid
  communityId String             @map("community_id") @db.Uuid
  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime           @default(now()) @map("published_at") @db.Timestamptz(6)
  status      AnnouncementStatus @default(draft)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([communityId])
  @@map("announcements")
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  location    String?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([communityId])
  @@map("events")
}

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  role        String
  phone       String
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([communityId])
  @@map("contacts")
}

model Dataset {
  id          String            @id @default(uuid()) @db.Uuid
  communityId String            @map("community_id") @db.Uuid
  community   Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  period      String?
  // string[] of column names / (string | number | null)[][] of rows.
  columns     Json
  rows        Json
  visibility  DatasetVisibility @default(draft)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([communityId])
  @@map("datasets")
}

model User {
  id                 String    @id
  name               String
  email              String
  emailVerified      Boolean   @default(false)
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  username           String?
  displayUsername    String?
  approved           Boolean   @default(false)
  isPlatformAdmin    Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
